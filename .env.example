# Copy only into a NEW local checkout; never replace an existing .env blindly.
# Compose and the API's fallback database resolver use this value.
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password

# The API does not automatically load the provider settings from this file.
# Supply these through the backend PROCESS environment when explicitly enabled.
# Default behavior is mock/SIMULATED; no provider request occurs on startup.
# AGENT_AI_PROVIDER=mock
# AGENT_LLM_ENABLED=false
# INTENTRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# INTENTRA_OLLAMA_MODEL=qwen3:4b
# INTENTRA_OLLAMA_TIMEOUT_SECONDS=120

# Optional PayPal Sandbox only. Never put real credentials in this example.
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_MERCHANTS={}
# INTENTRA_FRONTEND_URL=http://localhost:3000
# INTENTRA_ALLOWED_ORIGINS=http://localhost:3000
