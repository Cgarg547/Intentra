# This file is a safe operator reference. It is not loaded automatically.
# Export values via your shell, process manager, or deployment secret manager.

# Optional explicit database URL. If omitted, the backend reads
# POSTGRES_PASSWORD from the repository-root .env for local Compose only.
DATABASE_URL=postgresql+asyncpg://intentra:replace-with-a-unique-local-password@127.0.0.1:5433/intentra

# Local browser/frontend origin. In a deployed environment use the exact HTTPS
# Vercel origin (no trailing slash) for all three variables. Keep preview
# deployments out unless each is deliberately trusted.
INTENTRA_FRONTEND_URL=http://localhost:3000
INTENTRA_ALLOWED_ORIGINS=http://localhost:3000
INTENTRA_CORS_ORIGINS=http://localhost:3000

# Safe AI default: deterministic mock provider; no external inference.
AGENT_AI_PROVIDER=mock
AGENT_LLM_ENABLED=false

# Optional local-only Ollama configuration. Do not enable in an unreviewed
# deployment and do not put credentials in NEXT_PUBLIC variables.
# INTENTRA_OLLAMA_MODEL=qwen3:4b
# INTENTRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# INTENTRA_OLLAMA_TIMEOUT_SECONDS=120

# PayPal Sandbox values must be injected only by a secret manager/operator.
# Do not add client IDs, secrets, or merchant mappings to this file.
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_MERCHANTS={"internal_merchant_id":"SANDBOXMERCHANT"}
